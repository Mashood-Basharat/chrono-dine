# ===================================================
# ChronoDine Platform Configuration
# ===================================================

# Database Connection
# For PostgreSQL: postgresql://username:password@localhost:5432/restaurant_db
# For SQLite fallback: sqlite:///./restaurant_app.db
DATABASE_URL=sqlite:///./restaurant_app.db

# Video Stream Source
# Supports RTSP IP camera (rtsp://admin:pass@192.168.1.100:554/stream1), local video, or webcam index
STREAM_SOURCE=videos/Cctv Resturant.mp4

# AI Model & Confidence Parameters
YOLO_MODEL_PATH=models/yolo11s.pt
YOLO_POSE_MODEL_PATH=models/yolo11s-pose.pt
CONFIDENCE_THRESHOLD=0.25
POSE_CONFIDENCE_THRESHOLD=0.30

# Dwell Time Hysteresis (Seconds)
OCCUPY_HYSTERESIS_SECONDS=1.0
FREE_HYSTERESIS_SECONDS=1.5

# Operational Alerts
ALERT_IDLE_TABLE_MINUTES=15
ALERT_CAPACITY_PERCENT=85
